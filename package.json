{
  "name": "turnos-en-comun",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5179 --strictPort",
    "build": "node scripts/prepare-assets.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5179 --strictPort",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:ocr": "playwright test tests/ocr.spec.js tests/ocr-fallback.spec.js tests/import-formats.spec.js tests/import-context.spec.js tests/import-mobile.spec.js",
    "format": "prettier --write src tests scripts index.html package.json playwright.config.js",
    "format:check": "prettier --check src tests scripts index.html package.json playwright.config.js",
    "test:formats": "playwright test tests/import-formats.spec.js tests/import-context.spec.js tests/import-mobile.spec.js",
    "test:codecs": "playwright test tests/image-codecs.spec.js",
    "fixtures:codecs": "node scripts/generate-codec-fixtures.mjs",
    "test:tables": "playwright test tests/transposed.spec.js",
    "fixtures:tables": "node scripts/generate-table-fixtures.mjs",
    "test:mobile-review": "playwright test tests/mobile-review.spec.js",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "test:recomposition": "playwright test tests/recomposition.spec.js",
    "test:tiff-jpeg": "playwright test tests/tiff-jpeg.spec.js",
    "fixtures:jpeg": "node scripts/generate-jpeg-tiff-fixtures.mjs",
    "package:candidate": "node scripts/export-candidate.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "libheif-js": "1.23.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "utif": "3.1.0",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "ical.js": "^2.2.1",
    "icodec": "0.6.0",
    "prettier": "^3.9.10"
  }
}
